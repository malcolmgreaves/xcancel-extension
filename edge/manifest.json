{
  "manifest_version": 3,
  "name": "XCancel Redirect",
  "version": "1.0.0",
  "description": "Redirects x.com URLs to xcancel.com",
  "permissions": [
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "*://x.com/*",
    "*://www.x.com/*"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ruleset_1",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
